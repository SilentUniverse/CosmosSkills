{
  "schema_version": 1,
  "groups": {
    "catalog": {"purpose": "Validate skill discovery, links and resident budgets", "owner": "workflow"},
    "regression": {"purpose": "Execute Python behavior and integration regressions on all supported OSes", "owner": "workflow"},
    "windows": {"purpose": "Run native PowerShell and shell guard contracts", "owner": "tooling"},
    "ui": {"purpose": "Exercise actual browser failure, repair and fixed delivery", "owner": "workflow UI"},
    "packaging": {"purpose": "Build and run native fixed artifacts on each target platform", "owner": "workflow delivery"}
  },
  "always": ["catalog"],
  "rules": [
    {"paths": ["*.md", "docs/*", "LICENSE*", ".gitignore"], "groups": ["catalog"]},
    {"paths": ["workflow/spec/FEATURE-TEMPLATE.md"], "groups": ["regression"], "test_paths": ["tests/test_verify_artifacts.py", "tests/test_workflow_state.py", "tests/test_spec_review.py"]},
    {"paths": ["workflow/ARTIFACT-FORMAT.md"], "groups": ["regression"], "test_paths": ["tests/test_verify_artifacts.py", "tests/test_workflow_state.py", "tests/test_evidence.py"]},
    {"paths": ["workflow/workflow_ui.py"], "groups": ["regression", "ui"], "test_paths": ["tests/test_workflow_ui.py", "tests/test_ui_policy_routing.py", "tests/test_evidence.py", "tests/test_verify_artifacts.py"]},
    {"paths": ["workflow/tdd/scripts/playwright-reporter.cjs", "tests/ui_fixture/*.py", "tests/ui_fixture/*.cjs", "tests/ui_fixture/*.mjs", "tests/ui_fixture/*.html", "tests/ui_fixture/*.json", "scripts/check-ui-fixture.py"], "groups": ["regression", "ui"], "test_paths": ["tests/test_workflow_ui.py"]},
    {"paths": ["tests/packaging_fixture/*.py", "tests/packaging_fixture/*.cjs", "tests/packaging_fixture/*.json", "tests/packaging_fixture/requirements.txt", "scripts/check-native-packaging.py"], "groups": ["packaging"]},
    {"paths": ["workflow/evidence.py"], "groups": ["regression"], "test_paths": ["tests/test_evidence.py", "tests/test_verify_artifacts.py", "tests/test_workflow_state.py", "tests/test_ui_policy_routing.py", "tests/test_installers.py", "tests/test_spec_review.py", "tests/test_spec_review_encoding.py"]},
    {"paths": ["workflow/feature_doc.py"], "groups": ["regression"], "test_paths": ["tests/test_verify_artifacts.py", "tests/test_workflow_state.py", "tests/test_evidence.py", "tests/test_spec_review.py", "tests/test_spec_review_encoding.py", "tests/test_ui_policy_routing.py", "tests/test_installers.py"]},
    {"paths": ["workflow/workflow-state.py"], "groups": ["regression"], "test_paths": ["tests/test_workflow_state.py", "tests/test_ui_policy_routing.py", "tests/test_installers.py"]},
    {"paths": ["workflow/verify-artifacts.py"], "groups": ["regression", "windows"], "test_paths": ["tests/test_verify_artifacts.py", "tests/test_installers.py"]},
    {"paths": ["workflow/test_governance.py", "workflow/test-governance.py", "scripts/run-tests.py", "tests/test-policy.json", "scripts/ci-scope.py"], "groups": ["regression"], "test_paths": ["tests/test_test_governance.py"]},
    {"paths": ["scripts/validate-skills.py"], "groups": ["regression"], "test_paths": ["tests/test_validate_skills.py"]},
    {"paths": ["scripts/install.sh", "scripts/install.ps1", "install.cmd", "tooling/shell-guardrails/scripts/*.py", "tooling/shell-guardrails/scripts/*.sh", "tooling/shell-guardrails/scripts/*.ps1", "tooling/shell-guardrails/run_corpus.py", "tooling/shell-guardrails/cases.jsonl"], "groups": ["regression", "windows"], "test_paths": ["tests/test_installers.py"]},
    {"paths": ["workflow/test-verify-codebase.ps1"], "groups": ["windows"]},
    {"paths": ["workflow/spec/scripts/spec-review.py"], "groups": ["regression"], "test_paths": ["tests/test_spec_review.py", "tests/test_spec_review_encoding.py", "tests/test_verify_artifacts.py", "tests/test_workflow_state.py"]},
    {"paths": ["workflow/spec/scripts/pyright-impact.py"], "groups": ["regression"], "test_paths": ["tests/test_pyright_impact.py"]},
    {"paths": ["workflow/code-review/scripts/review-input.py"], "groups": ["regression"], "test_paths": ["tests/test_review_input.py"]},
    {"paths": ["workflow/pr/scripts/land.py"], "groups": ["regression"], "test_paths": ["tests/test_land.py"]},
    {"paths": ["scripts/eval.py", "scripts/eval_metrics.py", "evals/cases/*.json"], "groups": ["regression"], "test_paths": ["tests/test_eval.py"]},
    {"paths": ["evals/experiments/verify_loop.py", "evals/fixtures/verify-loop/*.py"], "groups": ["regression"], "test_paths": ["tests/test_verify_loop_fixture.py"]},
    {"paths": ["scripts/dsh_telemetry.py"], "groups": ["regression"], "test_paths": ["tests/test_dsh_telemetry.py"]},
    {"paths": ["scripts/zcode_telemetry.py"], "groups": ["regression"], "test_paths": ["tests/test_zcode_telemetry.py"]},
    {"paths": ["tests/evidence_fixtures.py"], "groups": ["regression"], "test_paths": ["tests/test_evidence.py", "tests/test_verify_artifacts.py", "tests/test_workflow_state.py"]},
    {"paths": ["tests/test_dsh_telemetry.py"], "groups": ["regression"], "test_paths": ["tests/test_dsh_telemetry.py"]},
    {"paths": ["tests/test_eval.py"], "groups": ["regression"], "test_paths": ["tests/test_eval.py"]},
    {"paths": ["tests/test_evidence.py"], "groups": ["regression"], "test_paths": ["tests/test_evidence.py"]},
    {"paths": ["tests/test_installers.py"], "groups": ["regression"], "test_paths": ["tests/test_installers.py"]},
    {"paths": ["tests/test_land.py"], "groups": ["regression"], "test_paths": ["tests/test_land.py"]},
    {"paths": ["tests/test_pyright_impact.py"], "groups": ["regression"], "test_paths": ["tests/test_pyright_impact.py"]},
    {"paths": ["tests/test_review_input.py"], "groups": ["regression"], "test_paths": ["tests/test_review_input.py"]},
    {"paths": ["tests/test_spec_review.py"], "groups": ["regression"], "test_paths": ["tests/test_spec_review.py", "tests/test_spec_review_encoding.py"]},
    {"paths": ["tests/test_spec_review_encoding.py"], "groups": ["regression"], "test_paths": ["tests/test_spec_review_encoding.py"]},
    {"paths": ["tests/test_test_governance.py"], "groups": ["regression"], "test_paths": ["tests/test_test_governance.py"]},
    {"paths": ["tests/test_ui_policy_routing.py"], "groups": ["regression"], "test_paths": ["tests/test_ui_policy_routing.py"]},
    {"paths": ["tests/test_validate_skills.py"], "groups": ["regression"], "test_paths": ["tests/test_validate_skills.py"]},
    {"paths": ["tests/test_verify_artifacts.py"], "groups": ["regression"], "test_paths": ["tests/test_verify_artifacts.py"]},
    {"paths": ["tests/test_verify_loop_fixture.py"], "groups": ["regression"], "test_paths": ["tests/test_verify_loop_fixture.py"]},
    {"paths": ["tests/test_workflow_contracts.py"], "groups": ["regression"], "test_paths": ["tests/test_workflow_contracts.py"]},
    {"paths": ["tests/test_workflow_state.py"], "groups": ["regression"], "test_paths": ["tests/test_workflow_state.py"]},
    {"paths": ["tests/test_workflow_ui.py"], "groups": ["regression"], "test_paths": ["tests/test_workflow_ui.py"]},
    {"paths": ["tests/test_zcode_telemetry.py"], "groups": ["regression"], "test_paths": ["tests/test_zcode_telemetry.py"]},
    {"paths": [".github/workflows/*.yml", ".github/workflows/*.yaml"], "groups": ["catalog", "regression", "windows", "ui", "packaging"]}
  ]
}
